{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "howmuch",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "HOWMUCH_DEFAULT_PLAN_ID": "80bc6db0-d926-4635-a37a-1ba0787c4c4e",
    "HOWMUCH_TIME_ZONE": "Asia/Singapore",
    "HOWMUCH_YNAB_PLAN_ID": "",
    "HOWMUCH_TRANSITION_READ_ONLY": "true",
    "HOWMUCH_REDIRECT_TARGET": "https://howmuch.tk.sg"
  },
  "triggers": {
    "crons": []
  },
  "routes": [
    {
      "pattern": "howmuch.soon.sg",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "howmuch-production",
    "database_id": "57dc5569-d639-44c1-bb9d-6214f43a43b8",
    "migrations_dir": "../api/d1-migrations"
  }],
  "env": {
    "preview": {
      "name": "howmuch-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": {
        "HOWMUCH_DEFAULT_PLAN_ID": "80bc6db0-d926-4635-a37a-1ba0787c4c4e",
        "HOWMUCH_TIME_ZONE": "Asia/Singapore",
        "HOWMUCH_TRANSITION_READ_ONLY": "false"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "howmuch-preview",
        "database_id": "7ca818bd-7f04-4b9b-8a84-8c8f84a6a272",
        "migrations_dir": "../api/d1-migrations"
      }]
    },
    "tk": {
      "name": "howmuch",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "howmuch.tk.sg",
          "custom_domain": true
        }
      ],
      // Daily HowMuch scheduled-transaction materialisation, 00:05 Asia/Singapore.
      "triggers": { "crons": ["5 16 * * *"] },
      // Reversible experiment (#172): the Worker runs at SIN while the D1
      // primary is at KIX, so every request pays cross-region hops on each
      // sequential D1 call. Smart Placement lets Cloudflare run the fetch
      // handler next to the database instead. Caveats: placement analysis
      // takes up to 15 minutes after deploy and needs consistent traffic from
      // multiple locations to decide; only fetch handlers are affected, so
      // the materialisation cron is unaffected. Cloudflare's usual "static
      // assets are unaffected" claim does NOT apply here: run_worker_first
      // (below) sends every request through the Worker first, so Wrangler
      // warns the whole Worker — asset path included — may be relocated.
      // Re-measurement method and revert criteria: docs/deployment.md.
      "placement": { "mode": "smart" },
      // Do NOT add HOWMUCH_REDIRECT_TARGET here. Wrangler warns that top-level
      // vars are not inherited by environments; that warning is expected. The
      // redirect belongs to the legacy YJ env only — setting it here would make
      // production redirect to itself in a loop.
      "vars": {
        "HOWMUCH_DEFAULT_PLAN_ID": "80bc6db0-d926-4635-a37a-1ba0787c4c4e",
        "HOWMUCH_TIME_ZONE": "Asia/Singapore",
        "HOWMUCH_YNAB_PLAN_ID": "",
        "HOWMUCH_TRANSITION_READ_ONLY": "false"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "howmuch-production-sg",
        "database_id": "d13295f9-10d4-4ac0-bf62-b3e8c78cbf29",
        "migrations_dir": "../api/d1-migrations"
      }]
    }
  }
}
