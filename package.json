{
  "name": "howmuch",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo:seed": "bun scripts/seed-demo.ts",
    "import:ynab": "bun scripts/import-ynab.ts",
    "verify:ynab-parity": "bun scripts/verify-ynab-parity.ts",
    "bootstrap:ynab-d1": "bun scripts/ynab-d1-bootstrap.ts",
    "import:ynab-export": "bun scripts/import-ynab-export.ts",
    "dev": "bun run dev:stack",
    "dev:stack": "./scripts/dev-stack.sh",
    "api:dev": "bun --hot apps/api/src/server.ts",
    "api:migrate": "bun apps/api/src/migrate.ts",
    "baseline:sqlite": "bun scripts/ledger-baseline.ts",
    "test:d1": "bun test apps/api/tests/d1.test.ts",
    "smoke": "bun scripts/smoke.ts",
    "verify:ios-focus-zoom": "bun scripts/verify-ios-focus-zoom.ts",
    "verify:ios-confirm-presentation": "bun scripts/verify-ios-confirm-presentation.ts",
    "verify:ios-register-swipe": "bun scripts/verify-ios-register-swipe.ts",
    "verify:ios-transaction-delete": "bun scripts/verify-ios-transaction-delete.ts",
    "verify:ios-accounts-shortcuts": "bun scripts/verify-ios-accounts-shortcuts.ts",
    "verify:ios-future-register": "bun scripts/verify-ios-future-register.ts",
    "verify:cleared-status-toggle": "bun scripts/verify-cleared-status-toggle.ts",
    "test": "bun test",
    "verify:worker": "bun run --cwd apps/worker build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}
